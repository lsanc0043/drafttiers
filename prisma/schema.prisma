generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BoardVisibility {
  PRIVATE
  SHARED
}

enum NbaSyncStatus {
  IDLE
  RUNNING
  SUCCESS
  FAILED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  displayName     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  boards          Board[]
  sleeperAccounts SleeperAccount[]
}

model Board {
  id            String         @id @default(cuid())
  name          String
  ownerId       String?
  owner         User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  visibility    BoardVisibility @default(PRIVATE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  buckets       Bucket[]
  assignments   BoardPlayer[]
  sleeperDrafts SleeperDraft[]

  @@index([ownerId])
}

model Bucket {
  id        String        @id @default(cuid())
  boardId   String
  board     Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  players   BoardPlayer[]

  @@index([boardId, sortOrder])
}

model Player {
  id           String        @id @default(cuid())
  nbaPersonId  Int           @unique
  firstName    String
  lastName     String
  fullName     String
  teamId       Int?
  teamAbbr     String?
  teamName     String?
  position     String?
  jerseyNumber String?
  fromYear     Int?
  isActive     Boolean       @default(false)
  syncedAt     DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  boardPlayers BoardPlayer[]
  seasonStats  PlayerSeasonStats[]
  gameLogs     PlayerGameLog[]

  @@index([fullName])
  @@index([lastName, firstName])
  @@index([teamAbbr])
  @@index([isActive])
}

model NbaSyncState {
  id             String        @id @default("nba-players")
  status         NbaSyncStatus @default(IDLE)
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  lastSuccessAt  DateTime?
  fetchedCount   Int?
  insertedCount  Int?
  updatedCount   Int?
  failedCount    Int?
  lastError      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model PlayerSeasonStats {
  id                      String   @id @default(cuid())
  playerId                String
  player                  Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season                  String
  gamesPlayed             Int
  minutes                 Float
  points                  Float
  rebounds                Float
  assists                 Float
  steals                  Float
  blocks                  Float
  turnovers               Float
  fieldGoalsMade          Float
  fieldGoalsAttempted     Float
  threePointersMade       Float
  threePointersAttempted  Float
  freeThrowsMade          Float
  freeThrowsAttempted     Float
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([playerId, season])
  @@index([season])
}

model PlayerGameLog {
  id                      String   @id @default(cuid())
  playerId                String
  player                  Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  gameId                  String
  gameDate                DateTime
  minutes                 Float
  points                  Int
  rebounds                Int
  assists                 Int
  steals                  Int
  blocks                  Int
  turnovers               Int
  fieldGoalsMade          Int
  fieldGoalsAttempted     Int
  threePointersMade       Int
  threePointersAttempted  Int
  freeThrowsMade          Int
  freeThrowsAttempted     Int
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([playerId, gameId])
  @@index([playerId, gameDate])
}

model TeamGame {
  id        String   @id @default(cuid())
  teamId    Int
  teamAbbr  String
  gameId    String
  gameDate  DateTime
  season    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, gameId])
  @@index([teamId, season, gameDate])
}

model BoardPlayer {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  bucketId  String
  bucket    Bucket   @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  sortOrder Int
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([boardId, playerId])
  @@index([bucketId, sortOrder])
}

model SleeperAccount {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sleeperUserId   String
  sleeperUsername String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  drafts          SleeperDraft[]

  @@unique([userId, sleeperUserId])
}

model SleeperDraft {
  id             String          @id @default(cuid())
  boardId        String
  board          Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  accountId      String?
  account        SleeperAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  sleeperDraftId String          @unique
  status         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  events         DraftEvent[]

  @@index([boardId])
}

model DraftEvent {
  id        String       @id @default(cuid())
  draftId   String
  draft     SleeperDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  createdAt DateTime     @default(now())

  @@index([draftId, createdAt])
}
